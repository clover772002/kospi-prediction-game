SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
OPENAI_API_KEY=your_openai_api_key_here

# 텔레그램 봇 설정 (BotFather에서 발급)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_BOT_USERNAME=your_bot_username_here

# 등급별 텔레그램 그룹 초대 링크
TELEGRAM_GROUP_ALL=https://t.me/your_all_group
TELEGRAM_GROUP_심해층=https://t.me/your_deepest_group
TELEGRAM_GROUP_지하층=https://t.me/your_underground_group
TELEGRAM_GROUP_지층=https://t.me/your_ground_group
TELEGRAM_GROUP_지상층=https://t.me/your_surface_group

# 인사이트 페이월 (false / 0 이면 토큰 차감 없이 열람)
INSIGHT_PAYWALL_ENABLED=true

# Stripe (토큰 팩 결제 · 웹훅으로 ledger 적립)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Dashboard에서 생성한 recurring 아님 one-time Price ID
STRIPE_PRICE_PACK_300=
STRIPE_PRICE_PACK_900=

# 성공 리다이렉트 등에 사용하는 공개 앱 URL (예: https://your-app.vercel.app)
PUBLIC_APP_URL=http://localhost:3000
